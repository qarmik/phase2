{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indusv.ai/schemas/intervention_log_rev7_1.json",
  "title": "Intervention Log — Protocol Qv Rev 7.1",
  "type": "object",
  "required": [
    "intervention_id",
    "timestamp_utc",
    "artifact_id",
    "intervention_type",
    "human_actor",
    "decision_summary",
    "eu_single_entry_point",
    "evidence_refs"
  ],
  "properties": {
    "intervention_id": { "type": "string" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "artifact_id": { "type": "string" },
    "intervention_type": {
      "type": "string",
      "enum": ["OVERRIDE", "ESCALATION", "ROLLBACK", "SHUTDOWN"]
    },
    "human_actor": {
      "type": "object",
      "required": ["role", "reason"],
      "properties": {
        "role": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "decision_summary": { "type": "string" },
    "eu_single_entry_point": {
      "type": "object",
      "required": ["route", "routing_classification", "harmonized_template"],
      "properties": {
        "route": { "type": "string", "const": "ENISA" },
        "routing_classification": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["AI_ACT_73", "GDPR_33", "NIS2", "DORA", "CER"]
          }
        },
        "harmonized_template": { "type": "boolean", "const": true }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
