{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indusv.ai/schemas/intervention_log_rev7_1.json",
  "title": "Intervention Log — Protocol Qv Rev 7.1",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "intervention_id",
    "timestamp_utc",
    "decision_summary",
    "human_accountable",
    "eu_single_entry_point"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "qv_rev7_1"
    },

    "intervention_id": {
      "type": "string"
    },

    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },

    "artifact_id": {
      "type": "string"
    },

    "intervention_type": {
      "type": "string",
      "enum": ["OVERRIDE", "ESCALATION", "ROLLBACK", "SHUTDOWN"]
    },

    "decision_summary": {
      "type": "string"
    },

    "human_accountable": {
      "type": "object",
      "required": ["role", "identifier"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "identifier": { "type": "string" }
      }
    },

    "eu_single_entry_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "routing_classification",
        "harmonized_template"
      ],
      "properties": {
        "route": {
          "type": "string",
          "const": "ENISA"
        },
        "routing_classification": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["AI_ACT_73", "GDPR_33", "NIS2", "DORA", "CER"]
          },
          "minItems": 1
        },
        "harmonized_template": {
          "type": "boolean",
          "const": true
        }
      }
    },

    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
